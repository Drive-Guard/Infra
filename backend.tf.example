###############################################################################
# Backend remoto (opcional)
#
# Por padrão o state fica local (terraform.tfstate, ignorado pelo Git). Isso
# basta para um aluno trabalhando sozinho no Learner Lab.
#
# Se mais de uma pessoa do grupo for aplicar a infra, use um backend S3 com
# lock no DynamoDB para evitar dois `apply` simultâneos corrompendo o state:
#
#   1. copie este arquivo para backend.tf
#   2. crie o bucket e a tabela UMA VEZ, fora deste Terraform:
#
#        aws s3api create-bucket \
#          --bucket driveguard-tfstate-SEU-SUFIXO \
#          --region us-east-1
#
#        aws s3api put-bucket-versioning \
#          --bucket driveguard-tfstate-SEU-SUFIXO \
#          --versioning-configuration Status=Enabled
#
#        aws dynamodb create-table \
#          --table-name driveguard-tflock \
#          --attribute-definitions AttributeName=LockID,AttributeType=S \
#          --key-schema AttributeName=LockID,KeyType=HASH \
#          --billing-mode PAY_PER_REQUEST \
#          --region us-east-1
#
#   3. ajuste o bucket abaixo e rode `terraform init -migrate-state`
#
# ATENÇÃO no Learner Lab: as credenciais expiram a cada sessão e a conta é
# zerada ao fim do curso. O bucket de state vai junto — guarde uma cópia do
# terraform.tfstate se precisar do histórico.
###############################################################################

terraform {
  backend "s3" {
    bucket         = "driveguard-tfstate-SEU-SUFIXO"
    key            = "driveguard/dev/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "driveguard-tflock"
    encrypt        = true
  }
}
