.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
.terraformrc
terraform.rc

# O state guarda a senha do RDS e a API Key em texto claro. Nunca versione.
# Para trabalho em equipe, use o backend S3 descrito em backend.tf.example.

# ----------------------------------------------------------------------------
# Variáveis com valores reais
# ----------------------------------------------------------------------------
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example

# ----------------------------------------------------------------------------
# Backend real (contém nome de bucket e caminho de state)
# ----------------------------------------------------------------------------
backend.tf
!backend.tf.example

