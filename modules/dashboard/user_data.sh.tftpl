#!/bin/bash
# =============================================================================
# DriveGuard — bootstrap da EC2 do dashboard (Amazon Linux 2023)
#
# O dashboard é uma SPA estática: o build é publicado no bucket de artefatos
# (prefixo site/, por scripts/publicar_site.*) e esta instância só o serve
# com nginx. Nada de Node.js nem clone de repositório aqui: o repositório do
# site é privado e o build roda na máquina de quem publica.
#
# 1. instala o nginx (o AWS CLI já vem no Amazon Linux 2023)
# 2. cria um timer do systemd que sincroniza site/ do S3 a cada minuto
#    e copia o config.json gerado pelo Terraform (URL da API e Cognito)
# 3. nginx serve a SPA com fallback para index.html
#
# Enquanto nada foi publicado, a instância serve uma página de espera.
# =============================================================================
set -uo pipefail

exec > >(tee /var/log/driveguard-bootstrap.log) 2>&1
echo "[driveguard] bootstrap iniciado em $(date -Is)"

AMBIENTE="${environment}"
REGIAO="${region}"
BUCKET="${site_bucket}"
RAIZ="/usr/share/nginx/driveguard"

dnf install -y nginx

mkdir -p "$RAIZ" /usr/share/nginx/driveguard-espera

cat > /usr/share/nginx/driveguard-espera/index.html <<HTML
<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>DriveGuard</title>
<style>
  body{font:16px/1.6 system-ui,sans-serif;max-width:40rem;margin:4rem auto;padding:0 1rem;color:#14181f}
  code{background:#f1f3f5;padding:.15em .4em;border-radius:4px}
</style>
<h1>DriveGuard ($AMBIENTE)</h1>
<p>A infraestrutura está no ar, mas o dashboard ainda não foi publicado.</p>
<p>Publique o build com <code>scripts/publicar_site.ps1</code> (ou <code>.sh</code>)
no repositório Infra. Esta página é trocada em até um minuto.</p>
HTML

# ---------------------------------------------------------- sincronização
cat > /usr/local/bin/driveguard-site-sync <<SYNC
#!/bin/bash
set -uo pipefail
# --exact-timestamps: sem ele, o sync do S3 para o disco ignora arquivos do
# mesmo tamanho, e o index.html novo (só muda o hash do JS) nunca seria copiado.
aws s3 sync "s3://$BUCKET/site/" "$RAIZ/" --delete --exact-timestamps --exclude config.json \
    --only-show-errors --region "$REGIAO"
aws s3 cp "s3://$BUCKET/site-config/config.json" "$RAIZ/config.json" \
    --only-show-errors --region "$REGIAO" || true
if [ ! -f "$RAIZ/index.html" ]; then
  cp /usr/share/nginx/driveguard-espera/index.html "$RAIZ/index.html"
fi
SYNC
chmod 755 /usr/local/bin/driveguard-site-sync

cat > /etc/systemd/system/driveguard-site-sync.service <<UNIT
[Unit]
Description=Sincroniza o dashboard DriveGuard a partir do S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/driveguard-site-sync
UNIT

cat > /etc/systemd/system/driveguard-site-sync.timer <<UNIT
[Unit]
Description=Sincroniza o dashboard DriveGuard a cada minuto

[Timer]
OnBootSec=15s
OnUnitActiveSec=60s
AccuracySec=5s

[Install]
WantedBy=timers.target
UNIT

# ------------------------------------------------------------------ nginx
cat > /etc/nginx/conf.d/driveguard.conf <<'NGINX'
server {
    listen 80 default_server;
    server_name _;
    root /usr/share/nginx/driveguard;
    index index.html;

    access_log /var/log/nginx/driveguard-access.log;
    error_log  /var/log/nginx/driveguard-error.log;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Gerado pelo Terraform: precisa refletir a configuração atual.
    location = /config.json {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # Arquivos com hash no nome: podem ficar em cache para sempre.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: qualquer rota desconhecida cai no index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
NGINX

# O default server do pacote conflita com o nosso listen 80 default_server.
sed -i 's/listen       80;/listen       8080;/; s/listen       \[::\]:80;/listen       [::]:8080;/' /etc/nginx/nginx.conf || true

/usr/local/bin/driveguard-site-sync || true

systemctl daemon-reload
systemctl enable --now driveguard-site-sync.timer
nginx -t && systemctl enable --now nginx && systemctl restart nginx

echo "[driveguard] bootstrap concluido em $(date -Is)"
